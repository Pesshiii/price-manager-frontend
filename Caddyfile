{
    # Railway сам терминирует HTTPS и отдаёт нам HTTP; ничего шифровать не надо.
    auto_https off
    admin off
}

:{$PORT} {
    encode gzip zstd

    # Бэкендные пути идут в Django через приватную сеть Railway.
    @backend {
        path /api/* /admin/* /static/* /media/*
    }
    handle @backend {
        reverse_proxy {$DJANGO_UPSTREAM} {
            header_up Host {host}
            # Railway терминирует HTTPS на своём edge и пересылает нам по HTTP
            # внутри приватной сети, поэтому {scheme} здесь == "http".
            # Django с SECURE_SSL_REDIRECT=True увидел бы http и сделал 301 →
            # POST превращается в GET → 405 на /api/auth/login/.
            # Внешний трафик к Railway всегда HTTPS, поэтому захардкодим.
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }

    # SPA: всё остальное — статика, неизвестные пути перехватывает index.html.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
